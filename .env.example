# Copy this file to .env and fill in real values. Never commit the real .env.

# MySQL/MariaDB connection string. connection_limit is deliberately low
# (see project notes on a local P1001 connection-flakiness issue) — raise it
# on production if the DB can comfortably handle more concurrent connections.
DATABASE_URL="mysql://user:password@host:3306/marketingai?connection_limit=5&pool_timeout=20"

# NextAuth session signing secret. Generate a fresh one for production —
# NEVER reuse the local dev value. `openssl rand -base64 32` works well.
AUTH_SECRET=""

# Cloudflare R2 (S3-compatible object storage) for generated images/videos/clips.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Public site URL — drives metadataBase, canonical URLs, sitemap.xml, and
# robots.txt (see src/lib/site.ts). Set to the real production domain,
# including https://.
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# Optional — YouTube cookies so Auto Clip's YouTube-URL import survives
# YouTube's anti-bot enforcement. See the comments in .env for the two ways
# to provide this (a cookies.txt file path, or a raw Cookie header string).
# Auto Clip's YouTube import still works without this, just less reliably.
# YOUTUBE_COOKIES_PATH="./youtube-cookies.txt"
# YOUTUBE_COOKIE_HEADER=""
